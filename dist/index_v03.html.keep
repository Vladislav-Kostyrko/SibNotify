<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<title>SibNotify</title>
<style>
  :root{
    --bg: rgba(14,16,22,.94);
    --bg2: rgba(26,29,38,.9);
    --line: rgba(255,255,255,.08);
    --txt: #e8ecf3;
    --dim: #8d96a8;
    --accent: #4aa3ff;
    --warn: #ffb020;
    --bad: #ff5c5c;
  }
  *{box-sizing:border-box; -webkit-user-select:none; user-select:none;}
  html,body{margin:0;padding:0;height:100%;background:transparent;overflow:hidden;
    font-family:"Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;color:var(--txt);font-size:13px;}
  body.strip{cursor:ew-resize;}
  body.strip.right{border-radius:4px 0 0 4px;}
  .rail{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(180deg,rgba(74,163,255,0),rgba(74,163,255,.5),rgba(74,163,255,0));opacity:.35;transition:opacity .15s;}
  body.strip:hover .rail{opacity:1;}

  .panel{position:fixed;inset:0;display:flex;flex-direction:column;background:var(--bg);
    backdrop-filter:blur(24px) saturate(140%);overflow:hidden;}
  body.panel.left .panel{border-right:1px solid rgba(255,255,255,.10);border-radius:0 16px 16px 0;box-shadow:12px 0 40px rgba(0,0,0,.5);}
  body.panel.right .panel{border-left:1px solid rgba(255,255,255,.10);border-radius:16px 0 0 16px;box-shadow:-12px 0 40px rgba(0,0,0,.5);}

  header{display:flex;align-items:center;gap:6px;padding:12px 14px 8px 14px;flex:none;}
  .brand{font-weight:600;letter-spacing:.14em;font-size:10px;color:var(--dim);}
  .sub{font-size:10.5px;color:var(--dim);margin-top:2px;}
  .clock{margin-left:auto;font-variant-numeric:tabular-nums;font-size:20px;font-weight:600;}
  .iconbtn{width:24px;height:24px;border-radius:7px;border:1px solid var(--line);background:var(--bg2);
    display:grid;place-items:center;cursor:pointer;color:var(--dim);font-size:12px;flex:none;}
  .iconbtn:hover{color:var(--txt);border-color:rgba(255,255,255,.25);}

  .grid{flex:1;overflow-y:auto;padding:4px 12px 10px;display:flex;flex-direction:column;}
  .grid::-webkit-scrollbar{width:7px;}
  .grid::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:6px;}
  .blk{background:var(--bg2);border:1px solid var(--line);border-radius:13px;margin:7px 0;display:flex;flex-direction:column;overflow:hidden;flex:none;}
  .blk h3{margin:0;padding:8px 11px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);
    display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--line);cursor:default;}
  .blk h3 .cnt{margin-left:auto;font-size:9.5px;background:rgba(255,255,255,.07);padding:1px 6px;border-radius:20px;}
  .blk h3 .cnt.hot{background:rgba(255,92,92,.2);color:#ffb3b3;}
  .blk h3 .bh{opacity:.35;font-size:11px;cursor:pointer;padding:0 2px;}
  .blk h3 .bh:hover{opacity:1;}
  .blk .bd{padding:9px 11px;overflow-y:auto;flex:1;}
  .blk .bd::-webkit-scrollbar{width:6px;}
  .blk .bd::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:6px;}
  .rh{height:9px;margin:0 0 -2px;cursor:ns-resize;display:flex;justify-content:center;align-items:flex-end;opacity:0;transition:opacity .12s;}
  .blk:hover .rh{opacity:1;}
  .rh i{width:26px;height:3px;border-radius:3px;background:rgba(255,255,255,.3);}

  .row{display:flex;align-items:center;gap:8px;font-size:11.5px;padding:1.5px 0;}
  .row .k{color:var(--dim);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .row .v{font-variant-numeric:tabular-nums;flex:none;}
  .bar{height:4px;border-radius:6px;background:rgba(255,255,255,.09);overflow:hidden;margin:3px 0 5px;}
  .bar > i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),#7ec3ff);}
  .bar.warn > i{background:linear-gradient(90deg,var(--warn),#ffd479);}
  .bar.bad > i{background:linear-gradient(90deg,var(--bad),#ff9a9a);}

  .item{padding:7px 0;border-bottom:1px dashed rgba(255,255,255,.07);cursor:pointer;}
  .item:last-child{border-bottom:none;}
  .item .t{font-size:12px;line-height:1.35;word-break:break-word;}
  .item .m{font-size:10px;color:var(--dim);margin-top:3px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
  .item:hover .t{color:#fff;}
  .badge{font-size:9px;padding:1px 6px;border-radius:20px;background:rgba(74,163,255,.16);color:#9ccbff;}
  .badge.due{background:rgba(255,176,32,.16);color:#ffcf72;}
  .badge.over{background:rgba(255,92,92,.16);color:#ff9d9d;}
  .empty{font-size:11px;color:var(--dim);padding:2px 0;}
  .err{font-size:11px;color:#ff9d9d;line-height:1.4;}
  .ctime{font-variant-numeric:tabular-nums;color:var(--dim);font-size:10.5px;display:inline-block;min-width:36px;}

  .addblock{margin:10px 0 18px;border:1px dashed rgba(255,255,255,.18);border-radius:12px;padding:10px;
    text-align:center;font-size:11.5px;color:var(--dim);cursor:pointer;flex:none;}
  .addblock:hover{border-color:var(--accent);color:var(--accent);background:rgba(74,163,255,.06);}

  .foot{display:flex;gap:6px;padding:7px 12px 10px;border-top:1px solid var(--line);flex:none;}
  .foot button{flex:1;background:#1a1e29;border:1px solid var(--line);color:var(--txt);border-radius:8px;
    padding:6px;font-size:11px;cursor:pointer;font-family:inherit;}
  .foot button:hover{border-color:rgba(255,255,255,.25);}
  .foot button.on{background:rgba(255,92,92,.18);border-color:rgba(255,92,92,.4);color:#ffb3b3;}

  /* модалки */
  .sheet{position:fixed;inset:0;background:rgba(6,8,12,.72);display:none;align-items:center;justify-content:center;padding:16px;z-index:20;}
  .sheet.on{display:flex;}
  .card{background:#10131b;border:1px solid rgba(255,255,255,.12);border-radius:16px;width:100%;max-height:100%;
    overflow-y:auto;padding:16px;box-shadow:0 24px 60px rgba(0,0,0,.7);}
  .card h2{margin:0 0 10px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);}
  .tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
  .tile{background:#171b25;border:1px solid var(--line);border-radius:11px;padding:11px 9px;cursor:pointer;text-align:center;}
  .tile:hover{border-color:var(--accent);background:#1b2230;}
  .tile .ic{font-size:17px;}
  .tile .nm{font-size:11px;margin-top:4px;}
  .tile .st{font-size:9px;color:#6d7789;margin-top:2px;}
  .field{display:flex;flex-direction:column;gap:3px;font-size:10.5px;color:var(--dim);margin-bottom:8px;}
  .field input,.field select,.field textarea{background:#161a24;border:1px solid var(--line);border-radius:8px;color:var(--txt);
    padding:7px 9px;font-size:12px;outline:none;font-family:inherit;resize:vertical;width:100%;}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
  .chk{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--txt);margin-bottom:6px;}
  .chk input{width:13px;height:13px;accent-color:var(--accent);}
  .btns{display:flex;gap:8px;margin-top:10px;}
  .btn{flex:1;border:1px solid var(--line);background:#1a1e29;color:var(--txt);border-radius:9px;padding:8px;font-size:11.5px;cursor:pointer;font-family:inherit;}
  .btn.primary{background:linear-gradient(180deg,#2f8cf5,#2470d0);border-color:#2f8cf5;}
  .btn.danger{color:#ffb3b3;border-color:rgba(255,92,92,.4);}
  .hint{font-size:10px;color:#6d7789;line-height:1.35;margin-top:6px;}
  .ok{color:#8ff0b6;}
  .bad{color:#ff9d9d;}
</style>
</head>
<body>
<script>
  document.body.className = (new URLSearchParams(location.search).get('mode') === 'strip') ? 'strip' : 'panel';
</script>

<div id="strip" class="rail" style="display:none"></div>

<div id="panel" class="panel" style="display:none">
  <header>
    <div>
      <div class="brand">SIBTRANS <span id="wx" style="font-size:10.5px;letter-spacing:0"></span></div>
      <div class="sub" id="date"></div>
    </div>
    <div class="clock" id="clock">--:--</div>
    <div class="iconbtn" id="btn-side" title="Перенести на другую сторону">⇄</div>
    <div class="iconbtn" id="btn-refresh" title="Обновить">⟳</div>
    <div class="iconbtn" id="btn-gear" title="Настройки">⚙</div>
  </header>

  <div class="grid" id="grid"></div>

  <div class="foot">
    <button id="act-task">+ Задача</button>
    <button id="act-dnd">DND</button>
    <button id="act-b24">Б24</button>
    <button id="act-mm">ММ</button>
  </div>

  <!-- выбор типа блока -->
  <div class="sheet" id="sh-add">
    <div class="card">
      <h2>Добавить блок</h2>
      <div class="tiles" id="tiles"></div>
      <div class="btns"><button class="btn" data-close="sh-add">Закрыть</button></div>
    </div>
  </div>

  <!-- настройка блока -->
  <div class="sheet" id="sh-cfg">
    <div class="card">
      <h2 id="cfg-title">Подключение</h2>
      <div id="cfg-fields"></div>
      <div id="cfg-status" class="hint"></div>
      <div class="btns">
        <button class="btn danger" id="cfg-del">Удалить блок</button>
        <button class="btn" data-close="sh-cfg">Отмена</button>
        <button class="btn primary" id="cfg-save">Добавить</button>
      </div>
    </div>
  </div>

  <!-- новая задача -->
  <div class="sheet" id="sh-task">
    <div class="card">
      <h2>Новая задача</h2>
      <div class="field">Название<input id="nt-title" /></div>
      <div class="field">Описание<textarea id="nt-desc" rows="3"></textarea></div>
      <div class="field">Дедлайн (пусто = без срока)<input id="nt-deadline" type="date" /></div>
      <div id="nt-status" class="hint"></div>
      <div class="btns">
        <button class="btn" data-close="sh-task">Отмена</button>
        <button class="btn primary" id="nt-save">Создать</button>
      </div>
    </div>
  </div>

  <!-- общие настройки -->
  <div class="sheet" id="sh-settings">
    <div class="card">
      <h2>Панель</h2>
      <div class="row2">
        <div class="field">Ширина окна, px<input id="s-width" type="number" min="280" max="1200" /></div>
        <div class="field">Прозрачность, %<input id="s-opacity" type="number" min="40" max="100" /></div>
      </div>
      <div class="row2">
        <div class="field">Сторона
          <select id="s-side"><option value="left">слева</option><option value="right">справа</option></select>
        </div>
        <div class="field">Обновление, сек<input id="s-refresh" type="number" min="15" /></div>
      </div>
      <label class="chk"><input type="checkbox" id="s-sound" /> Звук при новых событиях</label>
      <label class="chk"><input type="checkbox" id="s-move" /> Перетаскивать полоску мышью между мониторами</label>
      <div class="btns">
        <button class="btn" data-close="sh-settings">Отмена</button>
        <button class="btn primary" id="s-save">Сохранить</button>
      </div>
      <div class="btns"><button class="btn danger" id="s-quit">Выход</button></div>
    </div>
  </div>
</div>

<script>
(function () {
  const T = window.__TAURI__;
  const invoke = T ? T.core.invoke : async () => null;
  const $ = id => document.getElementById(id);
  const isStrip = document.body.classList.contains('strip');

  if (isStrip) {
    $('strip').style.display = 'block';
    document.addEventListener('mouseenter', () => invoke('show_panel'));
    document.addEventListener('mousedown', () => invoke('drag_start'));
    window.addEventListener('contextmenu', e => e.preventDefault());
    return;
  }

  $('panel').style.display = 'flex';
  let cfg = null, dnd = false, hideTimer = null, audioCtx = null, editing = null, seenComments = 0;

  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const R = (v, d) => (Math.round(v * 10) / 10).toFixed(d === undefined ? 1 : d);
  function rate(b) { return b > 1048576 ? (b / 1048576).toFixed(1) + ' МБ/с' : b > 1024 ? (b / 1024).toFixed(0) + ' КБ/с' : b + ' Б/с'; }
  function fmtD(iso) {
    if (!iso) return '';
    const d = new Date(String(iso).replace(' ', 'T'));
    if (isNaN(d)) return iso;
    return d.toDateString() === new Date().toDateString() ? 'сегодня'
      : d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit' });
  }
  function dCls(iso) {
    if (!iso) return '';
    const d = new Date(String(iso).replace(' ', 'T'));
    if (isNaN(d)) return '';
    const days = (d - new Date()) / 86400000;
    return days < 0 ? 'over' : days < 2 ? 'due' : '';
  }
  function beep() {
    if (!cfg || !cfg.sound || dnd) return;
    try {
      audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.type = 'sine'; o.frequency.value = 880; g.gain.value = .05;
      o.connect(g); g.connect(audioCtx.destination); o.start(); o.stop(audioCtx.currentTime + .12);
    } catch (e) {}
  }

  /* ---------- типы блоков ---------- */
  const TYPES = {
    system:   { name: 'Система',      ic: '▤', need: ['windows'],      def: { h: 170 }, fields: [] },
    tasks:    { name: 'Задачи Б24',   ic: '☑', need: ['b24'],          def: { h: 220 }, fields: ['deadline', 'limit'] },
    comments: { name: 'Комментарии',  ic: '💬', need: ['b24'],         def: { h: 180 }, fields: ['limit'] },
    chats:    { name: 'Чаты Б24',     ic: '✉', need: ['b24'],          def: { h: 190 }, fields: ['limit'] },
    mm:       { name: 'Mattermost',   ic: 'M', need: ['mm'],           def: { h: 190 }, fields: ['limit'] },
    tg:       { name: 'Telegram',     ic: '✈', need: ['tg'],           def: { h: 160 }, fields: [] },
    cal:      { name: 'Календарь',    ic: '▦', need: ['cal'],          def: { h: 180 }, fields: ['limit'] },
    mail:     { name: 'Почта',        ic: '✉', need: ['mail'],         def: { h: 160 }, fields: [] },
    weather:  { name: 'Погода',       ic: '☀', need: [],               def: { h: 90 },  fields: [] },
    clock:    { name: 'Часы',         ic: '◷', need: [],               def: { h: 90 },  fields: [] }
  };

  /* ---------- отрисовка ---------- */
  function blocks() { return (cfg && cfg.blocks) || []; }

  function render() {
    const g = $('grid');
    const list = blocks();
    g.innerHTML = (list.length ? list.map((b, i) => `
      <div class="rh" data-resize="${i}"><i></i></div>
      <div class="blk" data-i="${i}" style="height:${b.h || 170}px" data-type="${b.type}">
        <h3><span>${TYPES[b.type] ? TYPES[b.type].ic : '•'} ${esc(b.title || (TYPES[b.type] || {}).name || b.type)}</span>
          <span class="cnt" data-cnt="${i}">0</span>
          <span class="bh" data-cfg="${i}" title="Настроить">⚙</span>
          <span class="bh" data-up="${i}" title="Выше">▲</span>
          <span class="bh" data-down="${i}" title="Ниже">▼</span>
        </h3>
        <div class="bd" data-body="${i}"></div>
      </div>`).join('') : '<div class="empty" style="text-align:center;padding:24px 0">Блоков пока нет.<br>Жми «Добавить блок» ниже.</div>')
      + '<div class="addblock" id="addblock">+ Добавить блок</div>';

    $('addblock').onclick = () => openTiles();
    g.querySelectorAll('[data-cfg]').forEach(el => el.onclick = e => { e.stopPropagation(); openCfg(+el.dataset.cfg); });
    g.querySelectorAll('[data-up]').forEach(el => el.onclick = e => { e.stopPropagation(); move(+el.dataset.up, -1); });
    g.querySelectorAll('[data-down]').forEach(el => el.onclick = e => { e.stopPropagation(); move(+el.dataset.down, 1); });
    g.querySelectorAll('[data-resize]').forEach(el => attachResize(el));
    loadAll();
  }

  function move(i, d) {
    const b = blocks(), j = i + d;
    if (j < 0 || j >= b.length) return;
    const t = b[i]; b[i] = b[j]; b[j] = t;
    saveCfg(); render();
  }

  function attachResize(handle) {
    handle.onmousedown = ev => {
      ev.preventDefault();
      const i = +handle.dataset.resize;
      const blkEl = document.querySelector(`.blk[data-i="${i}"]`);
      const startY = ev.clientY, startH = blkEl.offsetHeight;
      const move = e => { blkEl.style.height = Math.max(70, startH + (e.clientY - startY)) + 'px'; };
      const up = () => {
        document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up);
        const b = blocks(); if (b[i]) b[i].h = blkEl.offsetHeight; saveCfg();
      };
      document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
    };
  }

  /* ---------- загрузка данных ---------- */
  async function loadAll() {
    for (const [i, b] of blocks().entries()) {
      const body = document.querySelector(`[data-body="${i}"]`);
      if (!body) continue;
      try {
        if (b.type === 'system') await sysBlock(b, body, i);
        else if (b.type === 'weather') weatherBlock(b, body, i);
        else if (b.type === 'clock') clockBlock(b, body, i);
        else if (b.type === 'tasks') await tasksBlock(b, body, i);
        else if (b.type === 'comments') await commentsBlock(b, body, i);
        else if (b.type === 'chats') await chatsBlock(b, body, i);
        else if (b.type === 'mm') await mmBlock(b, body, i);
        else if (b.type === 'tg') await tgBlock(b, body, i);
        else if (b.type === 'cal') await calBlock(b, body, i);
        else if (b.type === 'mail') body.innerHTML = '<div class="empty">Почта: настройку подключения сделаем следующим шагом</div>';
      } catch (e) { body.innerHTML = `<div class="err">${esc(e)}</div>`; }
    }
  }

  function setCnt(i, n, hot) {
    const el = document.querySelector(`[data-cnt="${i}"]`);
    if (el) { el.textContent = n; el.className = 'cnt' + (hot ? ' hot' : ''); }
  }

  async function sysBlock(b, body, i) {
    const s = await invoke('sys_stats');
    if (!s) return;
    const items = b.items || { cpu: true, ram: true, disk: true, net: true };
    let html = '';
    if (items.cpu) html += `<div class="row"><span class="k">CPU</span><span class="v">${s.cpu}%</span></div>
      <div class="bar ${s.cpu > 85 ? 'bad' : s.cpu > 60 ? 'warn' : ''}"><i style="width:${Math.min(100, s.cpu)}%"></i></div>`;
    if (items.ram) html += `<div class="row"><span class="k">Память</span><span class="v">${R(s.ram_used_gb)} / ${R(s.ram_total_gb)} ГБ</span></div>
      <div class="bar ${s.ram_pct > 85 ? 'bad' : s.ram_pct > 65 ? 'warn' : ''}"><i style="width:${s.ram_pct}%"></i></div>`;
    if (items.disk && s.disk && s.disk.total_gb) {
      const used = s.disk.total_gb - s.disk.free_gb, pct = Math.round(used / s.disk.total_gb * 100);
      html += `<div class="row"><span class="k">Диск ${esc(s.disk.mount)}</span><span class="v">${used.toFixed(0)} / ${s.disk.total_gb.toFixed(0)} ГБ</span></div>
        <div class="bar ${pct > 90 ? 'bad' : pct > 75 ? 'warn' : ''}"><i style="width:${pct}%"></i></div>`;
    }
    if (items.net) html += `<div class="row"><span class="k">Сеть</span><span class="v">↓${rate(s.net_down)} ↑${rate(s.net_up)}</span></div>`;
    body.innerHTML = html;
  }

  async function weatherBlock(b, body, i) {
    const r = await invoke('weather_now');
    if (!r || !r.ok) { body.innerHTML = `<div class="err">${esc((r && r.error) || 'нет данных')}</div>`; return; }
    body.innerHTML = `<div style="display:flex;align-items:center;gap:10px">
      <div style="font-size:26px">${r.icon}</div>
      <div><div style="font-size:20px;font-weight:600">${r.temp}°</div>
      <div style="font-size:10.5px;color:#8d96a8">ветер ${r.wind} м/с</div></div></div>`;
  }

  function clockBlock(b, body, i) {
    body.innerHTML = `<div style="font-size:26px;font-weight:600;font-variant-numeric:tabular-nums" id="clk${i}">--:--</div>
      <div style="font-size:10.5px;color:#8d96a8" id="cld${i}"></div>`;
    const upd = () => {
      const n = new Date();
      const a = document.getElementById('clk' + i), c = document.getElementById('cld' + i);
      if (a) a.textContent = n.toLocaleTimeString('ru-RU');
      if (c) c.textContent = n.toLocaleDateString('ru-RU', { weekday: 'long', day: '2-digit', month: 'long' });
    };
    upd();
  }

  async function tasksBlock(b, body, i) {
    const r = await invoke('b24_data');
    if (!r) return;
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    const list = (r.tasks || []).slice(0, b.limit || 12);
    setCnt(i, list.length);
    body.innerHTML = list.length ? list.map(t => `
      <div class="item" data-url="${esc(t.url)}">
        <div class="t">${esc(t.title)}</div>
        <div class="m">#${t.id}${t.deadline ? ` <span class="badge ${dCls(t.deadline)}">до ${fmtD(t.deadline)}</span>` : ''}${t.priority === '2' ? ' <span class="badge">!</span>' : ''}</div>
      </div>`).join('') : '<div class="empty">Задач нет</div>';
    body.querySelectorAll('.item').forEach(el => el.onclick = () => invoke('open_url', { url: el.dataset.url }));
  }

  async function commentsBlock(b, body, i) {
    const r = await invoke('b24_data');
    if (!r) return;
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    const list = (r.comments || []).slice(0, b.limit || 6);
    setCnt(i, list.length);
    body.innerHTML = list.length ? list.map(c => `
      <div class="item" data-url="${esc(c.task_url)}">
        <div class="t">${esc(c.text).slice(0, 200)}</div>
        <div class="m">#${c.task_id} · ${fmtD(c.date)} · ${esc(c.author || '')}</div>
      </div>`).join('') : '<div class="empty">Нового нет</div>';
    body.querySelectorAll('.item').forEach(el => el.onclick = () => invoke('open_url', { url: el.dataset.url }));
    const maxId = (r.comments || []).reduce((m, c) => Math.max(m, Number(c.task_id) * 1000 + Number(c.comment_id || 0)), 0);
    if (maxId > 0 && seenComments > 0 && maxId > seenComments) beep();
    if (maxId > 0) seenComments = Math.max(seenComments, maxId);
  }

  async function chatsBlock(b, body, i) {
    const r = await invoke('chats');
    if (!r) return;
    setCnt(i, r.total || 0, (r.total || 0) > 0);
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    const list = (r.dialogs || []).slice(0, b.limit || 6);
    body.innerHTML = list.length ? list.map(d => `
      <div class="item" data-url="${esc(d.url)}">
        <div class="t"><span class="badge">${d.count}</span> ${esc(d.title)}</div>
        <div class="m">${esc(d.text)}</div>
      </div>`).join('') : '<div class="empty">Нет непрочитанных</div>';
    body.querySelectorAll('.item').forEach(el => el.onclick = () => invoke('open_url', { url: el.dataset.url }));
  }

  async function mmBlock(b, body, i) {
    const r = await invoke('mm');
    if (!r) return;
    setCnt(i, r.mentions || 0, (r.mentions || 0) > 0);
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    const list = (r.channels || []).slice(0, b.limit || 6);
    body.innerHTML = list.length ? list.map(ch => `
      <div class="item" data-url="${esc(ch.url)}">
        <div class="t">${esc(ch.name)} <span class="badge ${ch.mentions ? 'over' : ''}">${ch.unread}${ch.mentions ? ' / @' + ch.mentions : ''}</span></div>
        ${ch.text ? `<div class="m">${esc(ch.text)}</div>` : ''}
      </div>`).join('') : '<div class="empty">Нет непрочитанных</div>';
    body.querySelectorAll('.item').forEach(el => el.onclick = () => invoke('open_url', { url: el.dataset.url }));
  }

  async function tgBlock(b, body, i) {
    const r = await invoke('tg');
    if (!r) return;
    setCnt(i, (r.messages || []).length);
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    body.innerHTML = (r.messages || []).length ? r.messages.map(m => `
      <div class="item"><div class="t">${esc(m.text)}</div><div class="m">${esc(m.from)}</div></div>`).join('')
      : '<div class="empty">Сообщений боту нет</div>';
  }

  async function calBlock(b, body, i) {
    const r = await invoke('cal');
    if (!r) return;
    if (!r.ok) { body.innerHTML = `<div class="err">${esc(r.error)}</div>`; return; }
    const list = (r.events || []).slice(0, b.limit || 8);
    setCnt(i, list.length);
    body.innerHTML = list.length ? list.map(e => `
      <div class="item" data-url="${esc(e.url || '')}">
        <div class="t"><span class="ctime">${esc(e.start_hhmm || '')}</span>${esc(e.title)}</div>
        <div class="m">${fmtD(e.start)}${e.end_hhmm ? ' – ' + esc(e.end_hhmm) : ''}${e.kind === 'ics' ? ' · внешний' : ''}</div>
      </div>`).join('') : '<div class="empty">Событий нет</div>';
    body.querySelectorAll('.item').forEach(el => el.onclick = () => { if (el.dataset.url) invoke('open_url', { url: el.dataset.url }); });
  }

  /* ---------- выбор типа ---------- */
  function openTiles() {
    $('tiles').innerHTML = Object.entries(TYPES).map(([k, t]) => `
      <div class="tile" data-t="${k}">
        <div class="ic">${t.ic}</div>
        <div class="nm">${t.name}</div>
        <div class="st">${t.need.length ? 'нужно подключение' : 'сразу работает'}</div>
      </div>`).join('');
    $('tiles').querySelectorAll('.tile').forEach(el => el.onclick = () => {
      closeSheet('sh-add');
      editing = { mode: 'new', type: el.dataset.t };
      openCfg(null);
    });
    openSheet('sh-add');
  }

  /* ---------- настройка блока ---------- */
  function fieldHtml(key, b) {
    if (key === 'deadline') return `<div class="field">Дедлайны
      <select id="f-deadline">
        <option value="all"${(b.deadline_filter || 'all') === 'all' ? ' selected' : ''}>все</option>
        <option value="week"${b.deadline_filter === 'week' ? ' selected' : ''}>на неделю</option>
        <option value="today"${b.deadline_filter === 'today' ? ' selected' : ''}>на сегодня</option>
      </select></div>`;
    if (key === 'limit') return `<div class="field">Сколько строк показывать<input id="f-limit" type="number" min="1" max="40" value="${b.limit || 8}" /></div>`;
    return '';
  }

  function openCfg(idx) {
    const isNew = idx === null;
    const type = isNew ? editing.type : blocks()[idx].type;
    const b = isNew ? Object.assign({ type: type, h: TYPES[type].def.h }, TYPES[type].def) : blocks()[idx];
    $('cfg-title').textContent = isNew ? ('Добавить: ' + TYPES[type].name) : ('Настроить: ' + (TYPES[type] || {}).name);
    $('cfg-del').style.display = isNew ? 'none' : '';
    $('cfg-save').textContent = isNew ? 'Добавить' : 'Сохранить';
    editing = { mode: isNew ? 'new' : 'edit', type, idx };

    let h = `<div class="field">Название блока<input id="f-title" value="${esc(b.title || TYPES[type].name)}" /></div>`;
    (TYPES[type].fields || []).forEach(k => { h += fieldHtml(k, b); });

    if (TYPES[type].need.includes('b24')) {
      h += `<div class="field">Вебхук Б24<input id="f-webhook" value="${esc(cfg.webhook || '')}" placeholder="https://b24.sibtrans.ru/rest/ID/TOKEN/" /></div>
            <div class="field">Твой ID в Б24<input id="f-user" type="number" value="${cfg.user_id || ''}" /></div>
            <div class="btns"><button class="btn" id="f-test">Проверить подключение</button></div>`;
    }
    if (TYPES[type].need.includes('mm')) {
      h += `<div class="field">Адрес Mattermost<input id="f-mm-url" value="${esc(cfg.mm_url || 'https://mm.sibtrans.ru')}" /></div>
            <div class="field">Личный токен ММ<input id="f-mm-token" value="${esc(cfg.mm_token || '')}" placeholder="Профиль → Безопасность → Токены" /></div>`;
    }
    if (TYPES[type].need.includes('tg')) {
      h += `<div class="field">Токен бота от @BotFather<input id="f-tg" value="${esc(cfg.tg_token || '')}" /></div>`;
    }
    if (TYPES[type].need.includes('cal')) {
      h += `<div class="field">Ссылки на календари .ics (по одной в строке)<textarea id="f-ics" rows="3" placeholder="Яндекс: Настройки → Экспорт → секретный адрес iCal">${esc(cfg.ics_urls || '')}</textarea></div>
            <div class="hint">События Б24 подтянутся автоматически по вебхуку.</div>`;
    }
    if (TYPES[type].need.includes('mail')) {
      h += `<div class="hint">Почту подключим отдельным этапом (IMAP/Exchange). Пока блок-заглушка.</div>`;
    }
    if (type === 'system') {
      const it = b.items || { cpu: true, ram: true, disk: true, net: true };
      h += `<label class="chk"><input type="checkbox" id="f-cpu" ${it.cpu ? 'checked' : ''}/> Процессор</label>
            <label class="chk"><input type="checkbox" id="f-ram" ${it.ram ? 'checked' : ''}/> Память</label>
            <label class="chk"><input type="checkbox" id="f-disk" ${it.disk ? 'checked' : ''}/> Диск</label>
            <label class="chk"><input type="checkbox" id="f-net" ${it.net ? 'checked' : ''}/> Сеть</label>`;
    }
    h += `<div class="field">Высота блока, px<input id="f-h" type="number" min="60" max="900" value="${b.h || 170}" /></div>`;
    $('cfg-fields').innerHTML = h;
    $('cfg-status').textContent = '';
    const test = $('f-test');
    if (test) test.onclick = async () => {
      $('cfg-status').textContent = 'Проверяю…';
      const r = await invoke('probe', { webhook: $('f-webhook').value.trim(), userId: parseInt($('f-user').value || '0', 10) });
      $('cfg-status').innerHTML = r && r.ok
        ? `<span class="ok">OK — ${esc(r.name)}${r.email ? ' (' + esc(r.email) + ')' : ''}</span>`
        : `<span class="bad">Ошибка: ${esc((r && r.error) || 'нет ответа')}</span>`;
    };
    openSheet('sh-cfg');
  }

  $('cfg-save').onclick = async () => {
    const type = editing.type;
    const t = TYPES[type];
    const item = {
      type,
      title: ($('f-title') || {}).value || t.name,
      h: parseInt(($('f-h') || {}).value || t.def.h, 10)
    };
    if ($('f-limit')) item.limit = parseInt($('f-limit').value || '8', 10);
    if ($('f-deadline')) item.deadline_filter = $('f-deadline').value;
    if (type === 'system' && $('f-cpu')) item.items = { cpu: $('f-cpu').checked, ram: $('f-ram').checked, disk: $('f-disk').checked, net: $('f-net').checked };

    if ($('f-webhook')) { cfg.webhook = $('f-webhook').value.trim(); cfg.user_id = parseInt($('f-user').value || '0', 10); }
    if ($('f-mm-url')) { cfg.mm_url = $('f-mm-url').value.trim(); cfg.mm_token = $('f-mm-token').value.trim(); }
    if ($('f-tg')) cfg.tg_token = $('f-tg').value.trim();
    if ($('f-ics')) cfg.ics_urls = $('f-ics').value;
    if ($('f-deadline')) cfg.deadline_filter = $('f-deadline').value;

    if (editing.mode === 'new') blocks().push(item);
    else blocks()[editing.idx] = item;
    await saveCfg();
    closeSheet('sh-cfg');
    render();
  };

  $('cfg-del').onclick = async () => {
    if (editing.mode !== 'edit') return;
    blocks().splice(editing.idx, 1);
    await saveCfg();
    closeSheet('sh-cfg');
    render();
  };

  /* ---------- прочее ---------- */
  function openSheet(id) { $(id).classList.add('on'); clearTimeout(hideTimer); }
  function closeSheet(id) { $(id).classList.remove('on'); }
  document.querySelectorAll('[data-close]').forEach(el => el.onclick = () => closeSheet(el.dataset.close));

  async function saveCfg() {
    cfg.blocks = blocks();
    await invoke('save_config', { cfg });
  }

  function tickClock() {
    const n = new Date();
    $('clock').textContent = n.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
    $('date').textContent = n.toLocaleDateString('ru-RU', { weekday: 'short', day: '2-digit', month: 'long' });
  }

  async function loadWx() {
    const r = await invoke('weather_now');
    $('wx').textContent = (r && r.ok) ? `${r.icon} ${r.temp}°` : '';
  }

  $('btn-gear').onclick = () => {
    $('s-width').value = cfg.panel_width || 400;
    $('s-opacity').value = cfg.opacity || 94;
    $('s-side').value = cfg.panel_side || 'left';
    $('s-refresh').value = cfg.refresh_secs || 60;
    $('s-sound').checked = !!cfg.sound;
    $('s-move').checked = true;
    openSheet('sh-settings');
  };
  $('s-save').onclick = async () => {
    cfg.panel_width = Math.max(280, Math.min(1200, parseInt($('s-width').value || '400', 10)));
    cfg.opacity = Math.max(40, Math.min(100, parseInt($('s-opacity').value || '94', 10)));
    cfg.panel_side = $('s-side').value;
    cfg.refresh_secs = Math.max(15, parseInt($('s-refresh').value || '60', 10));
    cfg.sound = $('s-sound').checked;
    await saveCfg();
    closeSheet('sh-settings');
    document.body.className = 'panel ' + (cfg.panel_side === 'right' ? 'right' : 'left');
  };
  $('s-quit').onclick = () => invoke('quit_app');

  $('btn-side').onclick = async () => {
    cfg.panel_side = cfg.panel_side === 'right' ? 'left' : 'right';
    document.body.className = 'panel ' + (cfg.panel_side === 'right' ? 'right' : 'left');
    await invoke('toggle_side');
  };
  $('btn-refresh').onclick = () => loadAll();

  $('act-b24').onclick = () => invoke('open_url', { url: 'https://b24.sibtrans.ru/' });
  $('act-mm').onclick = () => invoke('open_url', { url: (cfg && cfg.mm_url) || 'https://mm.sibtrans.ru' });
  $('act-dnd').onclick = () => { dnd = !dnd; $('act-dnd').classList.toggle('on', dnd); clearTimeout(hideTimer); };
  $('act-task').onclick = () => { $('nt-status').textContent = ''; openSheet('sh-task'); };
  $('nt-save').onclick = async () => {
    const title = $('nt-title').value.trim();
    if (!title) { $('nt-status').textContent = 'Нужно название'; return; }
    const dlm = $('nt-deadline').value;
    $('nt-status').textContent = 'Создаю…';
    const r = await invoke('add_task', {
      title, description: $('nt-desc').value,
      deadline: dlm ? Math.floor(new Date(dlm + 'T18:00:00').getTime() / 1000) : 0
    });
    if (r && r.ok) {
      $('nt-status').textContent = 'Задача #' + r.id + ' создана';
      $('nt-title').value = ''; $('nt-desc').value = ''; $('nt-deadline').value = '';
      loadAll();
      setTimeout(() => closeSheet('sh-task'), 900);
    } else $('nt-status').textContent = 'Ошибка: ' + ((r && r.error) || 'нет ответа');
  };

  function scheduleHide() { clearTimeout(hideTimer); hideTimer = setTimeout(() => { if (!dnd) invoke('hide_panel'); }, 700); }
  document.addEventListener('mouseleave', scheduleHide);
  document.addEventListener('mouseenter', () => clearTimeout(hideTimer));
  document.addEventListener('contextmenu', e => e.preventDefault());

  (async function init() {
    cfg = (await invoke('get_config')) || { panel_width: 400, opacity: 94, blocks: [] };
    if (!cfg.blocks) cfg.blocks = [];
    document.body.className = 'panel ' + (cfg.panel_side === 'right' ? 'right' : 'left');
    tickClock(); setInterval(tickClock, 1000);
    render();
    loadWx();
    setInterval(() => { if (!document.querySelector('.sheet.on')) loadAll(); }, 60000);
    setInterval(() => { if (!document.querySelector('.sheet.on') && blocks().some(b => b.type === 'system')) loadAll(); }, 15000);
    setInterval(loadWx, 900000);
    try {
      if (T && T.event) {
        T.event.listen('panel_shown', () => { if (!document.querySelector('.sheet.on')) loadAll(); });
        T.event.listen('blocked', e => { if (e.payload) invoke('hide_panel'); });
      }
    } catch (e) {}
  })();
})();
</script>
</body>
</html>
